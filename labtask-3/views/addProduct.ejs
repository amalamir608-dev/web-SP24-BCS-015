<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product</title>
    <link rel="stylesheet" href="/css/admin.css">

</head>

<body>

    <div class="form-container">

        <h1>Add Product</h1>

       <form
    action="/admin/add"
    method="POST"
    enctype="multipart/form-data"
>

            <input
                type="text"
                name="name"
                placeholder="Product Name"
                required
            >

            <input
                type="number"
                name="price"
                placeholder="Price"
                min="0"
                required
            >

            <input
                type="text"
                name="category"
                placeholder="Category"
                required
            >

            <input
                type="number"
                step="0.1"
                name="rating"
                placeholder="Rating"
                min="0"
                max="5"
                required
            >

            <input
                type="number"
                name="stock"
                placeholder="Stock"
                min="0"
                required
            >

            <input
                type="file"
                name="image"
                accept="image/*"
                required
>

            <button type="submit">
                Add Product
            </button>

        </form>

    </div>

</body>

</html>