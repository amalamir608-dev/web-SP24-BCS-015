<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Products</title>
    <link rel="stylesheet" href="/css/products.css">
</head>

<body>

    <h1>All Products</h1>

    <form action="/products" method="GET">

    <input
        type="text"
        name="search"
        placeholder="Search Products"
        value="<%= search %>"
    >

    <option value="">All Categories</option>

    <% categories.forEach(cat => { %>

    <option
        value="<%= cat %>"
        <%= category === cat ? "selected" : "" %>
    >
        <%= cat %>
    </option>

<% }) %>

    <div class="price-filter">

    <label>Minimum Price:</label>

    <input
        type="range"
        id="minSlider"
        name="minPrice"
        min="0"
        max="30000"
        value="<%= minPrice || 0 %>"
    >

    <span id="minValue">
        Rs <%= minPrice || 0 %>
    </span>

    <br><br>

    <label>Maximum Price:</label>

    <input
        type="range"
        id="maxSlider"
        name="maxPrice"
        min="1"
        max="30000"
        value="<%= maxPrice || 30000 %>"
    >

    <span id="maxValue">
        Rs <%= maxPrice || 30000 %>
    </span>

</div>

    <button type="submit">
        Filter
    </button>

</form>

    <div class="products-page">

    <h1 class="products-title">
        Nike Products
    </h1>

    <div class="products-grid">

        <% products.forEach(product => { %>

            <div class="product-card">

                <div class="product-image">

                    <img src="<%= product.image %>" alt="<%= product.name %>">

                </div>

                <div class="product-info">

                    <h2><%= product.name %></h2>

                    <p class="category">
                        <%= product.category %>
                    </p>

                    <p class="price">
                        Rs <%= product.price %>
                    </p>

                    <p class="rating">
                        Rating: <%= product.rating %> ⭐
                    </p>

                    <p class="stock">
                        Stock: <%= product.stock %>
                    </p>

                    <button>
                        View Product
                    </button>

                </div>

            </div>

        <% }) %>

    </div>

</div>

<div class="pagination">

    <% if(currentPage > 1) { %>

        <a href="/products?page=<%= currentPage - 1 %>">
            Previous
        </a>

    <% } %>

    <% for(let i = 1; i <= totalPages; i++) { %>

        <a
            href="/products?page=<%= i %>"
            class="<%= currentPage === i ? 'active-page' : '' %>"
        >
            <%= i %>
        </a>

    <% } %>

    <% if(currentPage < totalPages) { %>

        <a href="/products?page=<%= currentPage + 1 %>">
            Next
        </a>

    <% } %>

</div>
<script src = "/js/products.js" ></script>

</body>

</html>