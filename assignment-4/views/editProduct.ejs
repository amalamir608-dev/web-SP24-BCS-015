<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product</title>
    <link rel="stylesheet" href="/css/admin.css">

</head>

<body>

    <div class="form-container">

        <h1>Edit Product</h1>

        <form
        action="/admin/edit/<%= product._id %>"
        method="POST"
        enctype="multipart/form-data"
>

            <input
                type="text"
                name="name"
                value="<%= product.name %>"
                required
            >

            <input
                type="number"
                name="price"
                value="<%= product.price %>"
                min="0"
                required
            >

            <input
                type="text"
                name="category"
                value="<%= product.category %>"
                required
            >

            <input
                type="number"
                step="0.1"
                name="rating"
                value="<%= product.rating %>"
                min="0"
                max="5"
                required
            >

            <input
                type="number"
                name="stock"
                value="<%= product.stock %>"
                min="0"
                required
            >

            <label>Current Image:</label>

    <img
        src="<%= product.image %>"
        alt="<%= product.name %>"
        width="120"
>

    <input
        type="file"
        name="image"
        accept="image/*"
>

            <button type="submit">
                Update Product
            </button>

        </form>

    </div>

</body>

</html>