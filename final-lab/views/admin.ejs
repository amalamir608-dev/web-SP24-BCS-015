<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin.css">

</head>

<body>

    <div class="admin-container">

        <h1 class="admin-title">
            Admin Dashboard
        </h1>
        
        <a href="/admin/add" class="add-product-btn">
    Add Product
</a>
<a href="/sales" class="add-product-btn">
    View Sales Dashboard
</a>
        <table>

            <thead>

                <tr>

                    <th>Image</th>

                    <th>Name</th>

                    <th>Price</th>

                    <th>Category</th>

                    <th>Stock</th>

                    <th>Rating</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                <% products.forEach(product => { %>

                    <tr>

                        <td>

                            <img
                                src="<%= product.image %>"
                                alt="<%= product.name %>"
                            >

                        </td>

                        <td>
                            <%= product.name %>
                        </td>

                        <td>
                            Rs <%= product.price %>
                        </td>

                        <td>
                            <%= product.category %>
                        </td>

                        <td>
                            <%= product.stock %>
                        </td>

                        <td>
                            <%= product.rating %>
                        </td>

                        <td>

                            <a
    href="/admin/edit/<%= product._id %>"
    class="edit-btn"
>
    Edit
</a>

                            <form
    action="/admin/delete/<%= product._id %>"
    method="POST"
    onsubmit="return confirm('Are you sure you want to delete this product?')"
>

    <button class="delete-btn">
        Delete
    </button>

</form>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</body>

</html>